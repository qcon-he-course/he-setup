+	@Test
+	void createUniqueViolationMessageMatchedCaseInsensitively() throws Exception {
+		given(owners.saveAndFlush(any(Owner.class)))
+			.willThrow(new DataIntegrityViolationException("Duplicate key: UNIQUE_OWNER_PET_NAME"));
