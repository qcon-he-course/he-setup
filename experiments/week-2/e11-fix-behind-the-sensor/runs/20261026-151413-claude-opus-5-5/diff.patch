+			.andExpect(view().name("redirect:/owners/{ownerId}"))
+			.andExpect(flash().attribute("message", "Pet details has been edited"));
+
+		verify(owners).saveAndFlush(owner);
+		assertThat(owner.getPets()).hasSize(2);
+		assertThat(petty.getName()).isEqualTo("Betty");
+		assertThat(petty.getBirthDate()).isEqualTo(LocalDate.of(2015, 2, 12));
+		assertThat(petty.getType()).isSameAs(hamster);
+		assertThat(petty.getId()).isEqualTo(PETTY_ID);
+	}
+
+	@Test
+	void editCopiesNameBirthDateAndTypeOntoOwnersPetWhenInstancesDiffer() throws Exception {
+		given(this.owners.findById(OWNER_ID)).willAnswer(invocation -> {
+			Owner fresh = new Owner();
+			Pet freshPetty = new Pet();
+			freshPetty.setId(PETTY_ID);
+			freshPetty.setName("petty");
+			freshPetty.setBirthDate(LocalDate.of(2010, 1, 1));
+			fresh.addPet(freshPetty);
+			return Optional.of(fresh);
+		});
+		ArgumentCaptor<Owner> saved = ArgumentCaptor.forClass(Owner.class);
+
+		mockMvc
+			.perform(post("/owners/{ownerId}/pets/{petId}/edit", OWNER_ID, PETTY_ID).param("name", "Betty")
+				.param("type", "hamster")
+				.param("birthDate", "2015-02-12"))
+			.andExpect(status().is3xxRedirection());
+
+		verify(owners).saveAndFlush(saved.capture());
+		assertThat(saved.getValue().getPets()).hasSize(1);
+		Pet savedPet = saved.getValue().getPet(PETTY_ID);
+		assertThat(savedPet.getName()).isEqualTo("Betty");
+		assertThat(savedPet.getBirthDate()).isEqualTo(LocalDate.of(2015, 2, 12));
+		assertThat(savedPet.getType()).isSameAs(hamster);
+	}
+
+	@Test
+	void editDoesNotRequireType() throws Exception {
+		mockMvc
+			.perform(post("/owners/{ownerId}/pets/{petId}/edit", OWNER_ID, PETTY_ID).param("name", "Betty")
+				.param("birthDate", "2015-02-12"))
+			.andExpect(status().is3xxRedirection());
+	}
+
+	@Test
+	void editAcceptsBirthDateOfToday() throws Exception {
+		mockMvc
+			.perform(post("/owners/{ownerId}/pets/{petId}/edit", OWNER_ID, PETTY_ID).param("name", "Betty")
+				.param("type", "hamster")
+				.param("birthDate", LocalDate.now().toString()))
+			.andExpect(status().is3xxRedirection());
+	}
+
+	@Test
+	void editMissingBirthDateIsRequiredAndNotSaved() throws Exception {
+		mockMvc
+			.perform(post("/owners/{ownerId}/pets/{petId}/edit", OWNER_ID, PETTY_ID).param("name", "Betty")
