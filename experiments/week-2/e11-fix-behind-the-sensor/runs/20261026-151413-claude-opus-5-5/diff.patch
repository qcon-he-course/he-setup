+/**
+ * Characterization tests that pin the current validation and save behavior of
+ * {@link PetController} before it is restructured. They describe what the code does
+ * today, not necessarily what it should do.
+ */
+@WebMvcTest(value = PetController.class,
+		includeFilters = @ComponentScan.Filter(value = PetTypeFormatter.class, type = FilterType.ASSIGNABLE_TYPE))
+@DisabledInNativeImage
+@DisabledInAotMode
+class PetControllerCharacterizationTests {
+
+	private static final int OWNER_ID = 1;
+
+	private static final int PETTY_ID = 1;
+
+	private static final int DOGGY_ID = 2;
+
+	private static final String FORM = "pets/createOrUpdatePetForm";
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@MockitoBean
+	private OwnerRepository owners;
+
+	@MockitoBean
+	private PetTypeRepository types;
+
+	private Owner owner;
+
+	private Pet petty;
+
+	private PetType hamster;
+
+	@BeforeEach
+	void setup() {
+		hamster = new PetType();
+		hamster.setId(3);
+		hamster.setName("hamster");
+		given(this.types.findPetTypes()).willReturn(List.of(hamster));
+
+		owner = new Owner();
+		petty = new Pet();
+		petty.setId(PETTY_ID);
+		petty.setName("petty");
+		petty.setBirthDate(LocalDate.of(2010, 1, 1));
+		Pet doggy = new Pet();
+		doggy.setId(DOGGY_ID);
+		doggy.setName("doggy");
+		owner.addPet(petty);
+		owner.addPet(doggy);
+		given(this.owners.findById(OWNER_ID)).willReturn(Optional.of(owner));
+	}
+
+	// ---- create form ----
+
+	@Test
+	void createSavesOwnerWithNewPetAndFlashesMessage() throws Exception {
+		mockMvc
+			.perform(post("/owners/{ownerId}/pets/new", OWNER_ID).param("name", "Betty")
+				.param("type", "hamster")
+				.param("birthDate", "2015-02-12"))
+			.andExpect(status().is3xxRedirection())
+			.andExpect(view().name("redirect:/owners/{ownerId}"))
+			.andExpect(flash().attribute("message", "New Pet has been Added"));
+
+		verify(owners).saveAndFlush(owner);
+		Pet betty = owner.getPet("Betty");
+		assertThat(betty).isNotNull();
+		assertThat(betty.getBirthDate()).isEqualTo(LocalDate.of(2015, 2, 12));
+		assertThat(betty.getType()).isSameAs(hamster);
+		assertThat(owner.getPets()).hasSize(3);
+	}
+
+	@Test
+	void createAcceptsBirthDateOfToday() throws Exception {
+		mockMvc
+			.perform(post("/owners/{ownerId}/pets/new", OWNER_ID).param("name", "Betty")
+				.param("type", "hamster")
+				.param("birthDate", LocalDate.now().toString()))
+			.andExpect(status().is3xxRedirection());
+	}
+
+	@Test
+	void createRejectsBirthDateOfTomorrowWithCodeOnlyAndDoesNotSave() throws Exception {
+		MvcResult result = mockMvc
+			.perform(post("/owners/{ownerId}/pets/new", OWNER_ID).param("name", "Betty")
+				.param("type", "hamster")
+				.param("birthDate", LocalDate.now().plusDays(1).toString()))
+			.andExpect(status().isOk())
+			.andExpect(view().name(FORM))
+			.andExpect(model().errorCount(1))
+			.andExpect(model().attributeHasFieldErrorCode("pet", "birthDate", "typeMismatch.birthDate"))
+			.andReturn();
+
+		// SUSPECT: a future date is reported with the parse-error code typeMismatch
+		// and no default message.
+		assertThat(
+				result.getModelAndView().getModel().get("org.springframework.validation.BindingResult.pet").toString())
+			.contains("default message [null]");
+		verify(owners, never()).saveAndFlush(any());
+	}
+
+	@Test
+	void createMissingBirthDateIsRequired() throws Exception {
+		mockMvc.perform(post("/owners/{ownerId}/pets/new", OWNER_ID).param("name", "Betty").param("type", "hamster"))
+			.andExpect(status().isOk())
+			.andExpect(model().errorCount(1))
+			.andExpect(model().attributeHasFieldErrorCode("pet", "birthDate", "required"));
+	}
+
+	@Test
+	void createDuplicateNameIsCaseInsensitive() throws Exception {
+		mockMvc
+			.perform(post("/owners/{ownerId}/pets/new", OWNER_ID).param("name", "PETTY")
+				.param("type", "hamster")
+				.param("birthDate", "2015-02-12"))
+			.andExpect(status().isOk())
+			.andExpect(model().errorCount(1))
+			.andExpect(model().attributeHasFieldErrorCode("pet", "name", "duplicate"));
+		verify(owners, never()).saveAndFlush(any());
+	}
+
+	@Test
+	void createDuplicateCheckIgnoresUnsavedPetsOfOwner() throws Exception {
+		Pet unsaved = new Pet();
+		unsaved.setName("Ghost");
+		owner.getPets().add(unsaved);
+
+		mockMvc
+			.perform(post("/owners/{ownerId}/pets/new", OWNER_ID).param("name", "ghost")
+				.param("type", "hamster")
+				.param("birthDate", "2015-02-12"))
+			.andExpect(status().is3xxRedirection());
+	}
+
+	@Test
+	void createBlankNameReportsOnlyRequiredNotDuplicate() throws Exception {
+		mockMvc
+			.perform(post("/owners/{ownerId}/pets/new", OWNER_ID).param("name", "")
