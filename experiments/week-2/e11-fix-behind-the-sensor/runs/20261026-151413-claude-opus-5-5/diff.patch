+	@Test
+	void createReportsEveryValidatorErrorAtOnce() throws Exception {
+		mockMvc.perform(post("/owners/{ownerId}/pets/new", OWNER_ID).param("name", ""))
+			.andExpect(status().isOk())
+			.andExpect(model().errorCount(3))
+			.andExpect(model().attributeHasFieldErrorCode("pet", "name", "required"))
+			.andExpect(model().attributeHasFieldErrorCode("pet", "type", "required"))
+			.andExpect(model().attributeHasFieldErrorCode("pet", "birthDate", "required"));
+	}
+
+	@Test
+	void createUnparseableBirthDateReportsTypeMismatchAndRequired() throws Exception {
+		MvcResult result = mockMvc
+			.perform(post("/owners/{ownerId}/pets/new", OWNER_ID).param("name", "Betty")
+				.param("type", "hamster")
+				.param("birthDate", "2015/02/12"))
+			.andExpect(status().isOk())
+			.andExpect(model().errorCount(2))
+			.andExpect(model().attributeHasFieldErrorCode("pet", "birthDate", "typeMismatch"))
+			.andReturn();
+		BindingResult errors = (BindingResult) result.getModelAndView()
+			.getModel()
+			.get(BindingResult.MODEL_KEY_PREFIX + "pet");
+		assertThat(errors.getFieldErrors("birthDate")).extracting(FieldError::getCode)
+			.containsExactly("typeMismatch", "required");
+	}
+
+	@Test
+	void createIgnoresSubmittedId() throws Exception {
+		mockMvc
+			.perform(post("/owners/{ownerId}/pets/new", OWNER_ID).param("id", "99")
+				.param("name", "Betty")
+				.param("type", "hamster")
+				.param("birthDate", "2015-02-12"))
