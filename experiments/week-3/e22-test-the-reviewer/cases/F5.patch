+package org.springframework.samples.petclinic.owner;
+
+import java.util.Optional;
+
+import org.springframework.data.repository.Repository;
+
+/**
+ * Repository for <code>Pet</code> domain objects, for looking a pet up by its microchip
+ * number.
+ */
+public interface PetRepository extends Repository<Pet, Integer> {
+
+	/**
+	 * The pet with the given microchip number, if any.
+	 * @param microchipNumber the normalised microchip number
+	 * @return the pet, or empty
+	 */
+	Optional<Pet> findByMicrochipNumber(String microchipNumber);
+
+}
