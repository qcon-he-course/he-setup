diff --git a/src/main/java/org/springframework/samples/petclinic/owner/OwnerRepository.java b/src/main/java/org/springframework/samples/petclinic/owner/OwnerRepository.java
index b37f172..a4ecd98 100644
--- a/src/main/java/org/springframework/samples/petclinic/owner/OwnerRepository.java
+++ b/src/main/java/org/springframework/samples/petclinic/owner/OwnerRepository.java
@@ -84,4 +84,13 @@ public interface OwnerRepository extends JpaRepository<Owner, Integer> {
 	boolean existsAnotherPetWithMicrochipNumber(@Param("microchipNumber") String microchipNumber,
 			@Param("petId") Integer petId);
 
+	/**
+	 * The last name of the owner whose pet has the given microchip number, if any. It
+	 * loads no owner.
+	 * @param microchipNumber the normalised microchip number
+	 * @return the owner's last name, or empty
+	 */
+	@Query("SELECT owner.lastName FROM Owner owner JOIN owner.pets pet WHERE pet.microchipNumber = :microchipNumber")
+	Optional<String> findOwnerLastNameWithMicrochipNumber(@Param("microchipNumber") String microchipNumber);
+
 }
diff --git a/src/main/java/org/springframework/samples/petclinic/owner/PetValidator.java b/src/main/java/org/springframework/samples/petclinic/owner/PetValidator.java
index 58966ab..a207771 100644
--- a/src/main/java/org/springframework/samples/petclinic/owner/PetValidator.java
+++ b/src/main/java/org/springframework/samples/petclinic/owner/PetValidator.java
@@ -82,7 +82,10 @@ public class PetValidator implements Validator {
 				errors.rejectValue(MICROCHIP_NUMBER, "microchipNumber.invalid");
 			}
 			else if (isMicrochipNumberTakenByAnotherPet(pet)) {
-				rejectDuplicateMicrochipNumber(errors);
+				// Name the holder, so that reception can find the pet's record.
+				String holder = this.owners.findOwnerLastNameWithMicrochipNumber(microchipNumber)
+					.orElse("another owner");
+				errors.rejectValue(MICROCHIP_NUMBER, "duplicate", new Object[] { holder }, null);
 			}
 		}
 	}
