diff --git a/src/test/java/org/springframework/samples/petclinic/PetClinicConcurrencyTests.java b/src/test/java/org/springframework/samples/petclinic/PetClinicConcurrencyTests.java
index 6ca9f09..7156f19 100644
--- a/src/test/java/org/springframework/samples/petclinic/PetClinicConcurrencyTests.java
+++ b/src/test/java/org/springframework/samples/petclinic/PetClinicConcurrencyTests.java
@@ -2,7 +2,9 @@ package org.springframework.samples.petclinic;
 
 import static org.assertj.core.api.Assertions.assertThat;
 
+import java.util.List;
 import java.util.Optional;
+import java.util.concurrent.CopyOnWriteArrayList;
 import java.util.concurrent.CountDownLatch;
 import java.util.concurrent.ExecutorService;
 import java.util.concurrent.Executors;
@@ -38,7 +40,7 @@ public class PetClinicConcurrencyTests {
 	private RestTemplateBuilder restTemplateBuilder;
 
 	@Test
-	public void testDuplicatePetNameRaceConditionIsBlocked() throws Exception {
+	public void twoSimultaneousAddsWithTheSameName() throws Exception {
 		int ownerId = 1;
 		Optional<Owner> initialOwnerOpt = ownerRepository.findById(ownerId);
 		assertThat(initialOwnerOpt).isPresent();
@@ -131,4 +133,106 @@ public class PetClinicConcurrencyTests {
 		assertThat(countWithDuplicateName).isEqualTo(1);
 	}
 
+	@Test
+	public void twoSimultaneousAddsWithTheSameNumber() throws Exception {
+		int[] ownerIds = { 4, 5 };
+		String microchipNumber = "985141000777777";
+
+		assertThat(countPetsWithMicrochipNumber(microchipNumber)).isZero();
+
+		RestTemplate template = restTemplateBuilder.baseUri("http://localhost:" + port).build();
+
+		int threadCount = ownerIds.length;
+		ExecutorService executorService = Executors.newFixedThreadPool(threadCount);
+		CountDownLatch readyLatch = new CountDownLatch(threadCount);
+		CountDownLatch startLatch = new CountDownLatch(1);
+		CountDownLatch doneLatch = new CountDownLatch(threadCount);
+
+		List<ResponseEntity<String>> responses = new CopyOnWriteArrayList<>();
+		List<Exception> exceptions = new CopyOnWriteArrayList<>();
+
+		for (int ownerId : ownerIds) {
+			executorService.submit(() -> {
+				readyLatch.countDown();
+				try {
+					startLatch.await();
+
+					HttpHeaders headers = new HttpHeaders();
+					headers.setContentType(MediaType.APPLICATION_FORM_URLENCODED);
+
+					MultiValueMap<String, String> map = new LinkedMultiValueMap<>();
+					map.add("name", "RaceChip" + ownerId);
+					map.add("birthDate", "2020-01-01");
+					map.add("type", "cat");
+					map.add("microchipNumber", microchipNumber);
+
+					responses.add(template.postForEntity("/owners/" + ownerId + "/pets/new",
+							new HttpEntity<>(map, headers), String.class));
+				}
+				catch (Exception e) {
+					exceptions.add(e);
+				}
+				finally {
+					doneLatch.countDown();
+				}
+			});
+		}
+
+		try {
+			assertThat(readyLatch.await(10, TimeUnit.SECONDS)).isTrue();
+			startLatch.countDown();
+			assertThat(doneLatch.await(10, TimeUnit.SECONDS)).isTrue();
+		}
+		finally {
+			executorService.shutdown();
+		}
+
+		assertThat(exceptions).isEmpty();
+		assertThat(responses).hasSize(2);
+
+		// The loser gets the form again (200) with the duplicate error on the microchip
+		// number, whichever of the validator or the database caught it.
+		List<ResponseEntity<String>> rejected = responses.stream()
+			.filter(r -> r.getStatusCode().value() == 200 && hasDuplicateErrorOnMicrochipNumber(r.getBody()))
+			.toList();
+		assertThat(rejected).hasSize(1);
+
+		ResponseEntity<String> winner = responses.stream().filter(r -> !rejected.contains(r)).findFirst().orElseThrow();
+		assertThat(winner.getStatusCode().is2xxSuccessful() || winner.getStatusCode().is3xxRedirection()).isTrue();
+		assertThat(winner.getBody() == null || !winner.getBody().contains("is already in use")).isTrue();
+
+		assertThat(countPetsWithMicrochipNumber(microchipNumber)).isEqualTo(1);
+		long racePets = 0;
+		for (int ownerId : ownerIds) {
+			racePets += ownerRepository.findById(ownerId)
+				.orElseThrow()
+				.getPets()
+				.stream()
+				.filter(p -> p.getName().startsWith("RaceChip"))
+				.count();
+		}
+		assertThat(racePets).isEqualTo(1);
+	}
+
+	private long countPetsWithMicrochipNumber(String microchipNumber) {
+		return ownerRepository.findAll()
+			.stream()
+			.flatMap(o -> o.getPets().stream())
+			.filter(p -> microchipNumber.equals(p.getMicrochipNumber()))
+			.count();
+	}
+
+	/**
+	 * The microchip number field comes after the name and birth date fields on the form,
+	 * so its error is the only "is already in use" after the microchip number input.
+	 */
+	private static boolean hasDuplicateErrorOnMicrochipNumber(String body) {
+		if (body == null) {
+			return false;
+		}
+		int field = body.indexOf("id=\"microchipNumber\"");
+		return field >= 0 && !body.substring(0, field).contains("is already in use")
+				&& body.substring(field).contains("is already in use");
+	}
+
 }
