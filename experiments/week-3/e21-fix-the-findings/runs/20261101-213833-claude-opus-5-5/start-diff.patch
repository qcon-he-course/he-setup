+
+	@Test
+	void migrationAddsMicrochipNumberToReleaseOneTable() {
+		JdbcTemplate admin = new JdbcTemplate(this.dataSource);
+		admin.execute("DROP DATABASE IF EXISTS " + DATABASE + " WITH (FORCE)");
+		admin.execute("CREATE DATABASE " + DATABASE);
+		String url = this.connectionDetails.getJdbcUrl().replaceFirst("/[^/?]*(\\?|$)", "/" + DATABASE + "$1");
+		DriverManagerDataSource migrationDatabase = new DriverManagerDataSource(url,
+				this.connectionDetails.getUsername(), this.connectionDetails.getPassword());
+		new MicrochipNumberMigrationScenario(migrationDatabase, "postgres", "current_schema()").run();
+	}
+
+}
