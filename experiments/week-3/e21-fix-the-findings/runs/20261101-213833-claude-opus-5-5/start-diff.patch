+package org.springframework.samples.petclinic;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.hamcrest.Matchers.containsString;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.content;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.view;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.webmvc.test.autoconfigure.AutoConfigureMockMvc;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.ResultActions;
+
+/**
+ * Adds, edits and clears a pet's microchip number through the forms on H2, and reads the
+ * stored value from the database after each step. The test runs no transaction of its
+ * own, so each request saves as it does in the running app, with a detached pet
+ * ({@code spring.jpa.open-in-view=false}).
+ */
+@SpringBootTest
+@AutoConfigureMockMvc
+class PetMicrochipNumberIntegrationTests {
+
+	private static final int OWNER_ID = 3;
+
+	private static final String FORM = "pets/createOrUpdatePetForm";
+
+	@Autowired
+	private MockMvc mockMvc;
+
+	@Autowired
+	private JdbcTemplate jdbc;
+
+	@Test
+	void microchipNumberIsAddedReplacedAndClearedThroughTheForms() throws Exception {
+		this.mockMvc
+			.perform(post("/owners/{ownerId}/pets/new", OWNER_ID).param("name", "Chippy")
+				.param("type", "dog")
+				.param("birthDate", "2020-01-01")
+				.param("microchipNumber", "985141000123456"))
+			.andExpect(status().is3xxRedirection());
+		Integer petId = this.jdbc.queryForObject("SELECT id FROM pets WHERE owner_id = ? AND name = ?", Integer.class,
+				OWNER_ID, "Chippy");
+		assertThat(storedMicrochipNumber(petId)).isEqualTo("985141000123456");
+
+		edit(petId, "12345").andExpect(status().isOk())
+			.andExpect(view().name(FORM))
+			.andExpect(content().string(containsString("must be 15 digits")));
+		assertThat(storedMicrochipNumber(petId)).isEqualTo("985141000123456");
+
+		edit(petId, "985141000654321").andExpect(status().is3xxRedirection());
+		assertThat(storedMicrochipNumber(petId)).isEqualTo("985141000654321");
+
+		edit(petId, "").andExpect(status().is3xxRedirection());
+		assertThat(storedMicrochipNumber(petId)).isNull();
+	}
+
+	private ResultActions edit(int petId, String microchipNumber) throws Exception {
+		return this.mockMvc.perform(post("/owners/{ownerId}/pets/{petId}/edit", OWNER_ID, petId).param("name", "Chippy")
+			.param("type", "dog")
+			.param("birthDate", "2020-01-01")
+			.param("microchipNumber", microchipNumber));
+	}
+
+	private String storedMicrochipNumber(int petId) {
+		return this.jdbc.queryForObject("SELECT microchip_number FROM pets WHERE id = ?", String.class, petId);
+	}
+
+}
