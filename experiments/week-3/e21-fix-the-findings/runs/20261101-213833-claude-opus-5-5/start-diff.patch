+ */
+@SpringBootTest(webEnvironment = WebEnvironment.NONE, properties = { "spring.docker.compose.skip.in-tests=false", //
+		"spring.docker.compose.start.arguments=--force-recreate,--renew-anon-volumes,postgres", //
+		"spring.sql.init.mode=never" })
+@ActiveProfiles("postgres")
+@DisabledInNativeImage
+class PostgresMicrochipNumberMigrationTests {
+
+	private static final String DATABASE = "pc301_migration";
+
+	@Autowired
