diff --git a/src/test/java/org/springframework/samples/petclinic/MicrochipNumberMigrationScenario.java b/src/test/java/org/springframework/samples/petclinic/MicrochipNumberMigrationScenario.java
new file mode 100644
index 0000000..f59172c
--- /dev/null
+++ b/src/test/java/org/springframework/samples/petclinic/MicrochipNumberMigrationScenario.java
@@ -0,0 +1,119 @@
+/*
+ * Copyright 2012-2025 the original author or authors.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      https://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package org.springframework.samples.petclinic;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import java.sql.Date;
+
+import javax.sql.DataSource;
+
+import org.springframework.core.io.ClassPathResource;
+import org.springframework.dao.DataIntegrityViolationException;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.jdbc.datasource.init.ResourceDatabasePopulator;
+
+/**
+ * The PC-301 deployment steps, run against an empty MySQL or Postgres database: release
+ * 1's schema and seed data, then the migration script, then release 1 again (what a
+ * rollback redeploys), then release 2's schema and seed data. Release 1's scripts are
+ * kept as test resources under {@code pc-301-release-1/}.
+ */
+class MicrochipNumberMigrationScenario {
+
+	private static final String NUMBER = "985141000123456";
+
+	private final DataSource dataSource;
+
+	private final JdbcTemplate jdbc;
+
+	private final String database;
+
+	private final String currentSchema;
+
+	/**
+	 * @param database {@code mysql} or {@code postgres}
+	 * @param currentSchema the SQL expression for the schema the tables are in
+	 */
+	MicrochipNumberMigrationScenario(DataSource dataSource, String database, String currentSchema) {
+		this.dataSource = dataSource;
+		this.jdbc = new JdbcTemplate(dataSource);
+		this.database = database;
+		this.currentSchema = currentSchema;
+	}
+
+	void run() {
+		// Release 1 on an empty database: the pets table before this change.
+		runReleaseOne();
+		assertThat(hasMicrochipNumberColumn()).as("pets has no microchip_number column before the migration").isFalse();
+		this.jdbc.update("INSERT INTO pets (name, birth_date, type_id, owner_id) VALUES (?, ?, ?, ?)", "Unchipped",
+				Date.valueOf("2020-01-01"), 1, 1);
+		Integer existingPetId = this.jdbc.queryForObject("SELECT id FROM pets WHERE owner_id = 1 AND name = ?",
+				Integer.class, "Unchipped");
+
+		runScript("db/" + this.database + "/migrate-pc-301-microchip-number.sql");
+
+		assertThat(hasMicrochipNumberColumn()).isTrue();
+		assertThat(
+				this.jdbc.queryForObject("SELECT microchip_number FROM pets WHERE id = ?", String.class, existingPetId))
+			.isNull();
+		assertThat(
+				this.jdbc.queryForObject("SELECT COUNT(*) FROM pets WHERE microchip_number IS NOT NULL", Integer.class))
+			.isZero();
+
+		insertPet("NoChipOne", 1, null);
+		insertPet("NoChipTwo", 2, null);
+
+		insertPet("ChipOne", 1, NUMBER);
+		assertThatThrownBy(() -> insertPet("ChipTwo", 2, NUMBER)).isInstanceOf(DataIntegrityViolationException.class)
+			.satisfies(ex -> assertThat(ex.getMessage()).containsIgnoringCase("unique_pet_microchip_number"));
+
+		// Rollback from release 2 redeploys release 1: it must start on the migrated
+		// table.
+		runReleaseOne();
+
+		// Deployment step 5: release 2 starts on the migrated table.
+		runScript("db/" + this.database + "/schema.sql");
+		runScript("db/" + this.database + "/data.sql");
+		assertThat(
+				this.jdbc.queryForObject("SELECT COUNT(*) FROM pets WHERE microchip_number = ?", Integer.class, NUMBER))
+			.isEqualTo(1);
+	}
+
+	private void runReleaseOne() {
+		runScript("pc-301-release-1/" + this.database + "/schema.sql");
+		runScript("pc-301-release-1/" + this.database + "/data.sql");
+	}
+
+	private void runScript(String path) {
+		new ResourceDatabasePopulator(new ClassPathResource(path)).execute(this.dataSource);
+	}
+
+	private boolean hasMicrochipNumberColumn() {
+		Integer count = this.jdbc.queryForObject("SELECT COUNT(*) FROM information_schema.columns WHERE table_schema = "
+				+ this.currentSchema + " AND table_name = 'pets' AND column_name = 'microchip_number'", Integer.class);
+		return count != null && count > 0;
+	}
+
+	private void insertPet(String name, int ownerId, String microchipNumber) {
+		this.jdbc.update(
+				"INSERT INTO pets (name, birth_date, type_id, owner_id, microchip_number) VALUES (?, ?, ?, ?, ?)", name,
+				Date.valueOf("2020-01-01"), 1, ownerId, microchipNumber);
+	}
+
+}
